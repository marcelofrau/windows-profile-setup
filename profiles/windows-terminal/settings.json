{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",

    "copyOnSelect": true,
    "copyFormatting": "all",
    "alwaysOnTop": false,
    "initialCols": 318,
    "initialRows": 30,
    "initialPosition": "0,0",
    "launchMode": "default",
    "tabWidthMode": "compact",
    "windowingBehavior": "useExisting",
    "useAcrylicInTabRow": true,

    "disabledProfileSources": [
        "Windows.Terminal.Azure",
        "Windows.Terminal.VisualStudio",
        "Windows.Terminal.Wsl"
    ],

    "keybindings": [
        { "id": null, "keys": "win+`" },
        { "id": "Terminal.NextTab", "keys": "ctrl+pgdn" },
        { "id": "Terminal.TogglePaneZoom", "keys": "alt+enter" },
        { "id": "Terminal.CopyToClipboard", "keys": "ctrl+shift+c" },
        { "id": "Terminal.PasteFromClipboard", "keys": "ctrl+v" },
        { "id": "Terminal.FindText", "keys": "ctrl+shift+f" },
        { "id": "Terminal.DuplicatePaneAuto", "keys": "alt+shift+d" },
        { "id": "Terminal.PrevTab", "keys": "ctrl+pgup" },
        { "id": "Terminal.ClosePane", "keys": "ctrl+d" }
    ],

    "profiles": {
        "defaults": {
            "bellStyle": "window",
            "rightClickContextMenu": false,
            "scrollbarState": "hidden",
            "showMarksOnScrollbar": true
        },
        "list": [
            {
                "name": "Starship",
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "colorScheme": "Cobalt Neon",
                "font": { "face": "EnvyCodeR Nerd Font", "size": 14 },
                "commandline": "pwsh.exe -NoProfile -NoExit -Command \"& '%USERPROFILE%\\windows-profile-setup\\profiles\\powershell\\Microsoft.PowerShell_profile.ps1'\"",
                "icon": "%USERPROFILE%\\windows-profile-setup\\assets\\starship.png",
                "hidden": false
            },
            {
                "name": "CMD (Clink)",
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "colorScheme": "Flat",
                "commandline": "cmd.exe /k \"%USERPROFILE%\\windows-profile-setup\\profiles\\powershell\\cmd_aliases.cmd\"",
                "experimental.retroTerminalEffect": true,
                "hidden": false
            },
            {
                "name": "PowerShell 7",
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "colorScheme": "Hopscotch.256",
                "font": { "face": "FantasqueSansM Nerd Font", "size": 14 },
                "source": "Windows.Terminal.PowershellCore",
                "hidden": false
            },
            {
                "name": "Ubuntu (WSL)",
                "guid": "{51855cb2-8cce-5362-8f54-464b92b32386}",
                "colorScheme": "Ubuntu",
                "font": { "face": "ProFont IIx Nerd Font" },
                "source": "Windows.Terminal.Wsl",
                "hidden": false
            }
        ]
    },

